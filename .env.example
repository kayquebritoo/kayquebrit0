# ===== KBOS — copie para .env.local (NUNCA commite) =====
# Banco Postgres (Neon, Supabase...). Sem ele, as rotas /api/* retornam 503
# com instrução — o site público segue funcionando.
# Schema: `npx drizzle-kit push` (cria as tabelas kbos_*)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# URL pública (links do magic link + callbacks).
# Produção (VPS): APP_URL="https://kbos.kayquebrito.com.br"
APP_URL="http://localhost:3000"

# E-mail do magic link (Resend). Sem isso, o link aparece no terminal em dev.
RESEND_API_KEY=""
RESEND_FROM="KBOS <portal@kayquebrito.com.br>"
# Alias aceito no lugar de RESEND_FROM:
EMAIL_FROM="KBOS <portal@kayquebrito.com.br>"
# SMTP genérico (fallback quando sem Resend; requer `npm i nodemailer`):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=""

# WhatsApp (Evolution API, profile `evolution` do compose). Zero-config no
# compose: URL (`http://evolution:8080`) e instância (`kbos-primary`) já vêm
# por padrão — o ESSENCIAL é a chave (precisa coincidir com
# `AUTHENTICATION_API_KEY` do serviço `evolution`). Sem chave forte, vale a
# default de dev `kbos-dev-key` (a UI avisa). Produção: gere com
# `openssl rand -hex 32`, salve aqui e recrie com `up -d --build`.
# A instância é auto-criada (com webhook) ao abrir /admin/whatsapp.
WHATSAPP_PROVIDER=""
EVOLUTION_API_URL="http://evolution:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="kbos-primary"
# Inbox Fase 2: segredo do webhook inbound (opcional; ≥8 chars). Quando definido,
# a Evolution deve enviá-lo em `?token=` ou no header `x-webhook-token`.
# URL do webhook: https://<vps>/api/webhooks/evolution (eventos MESSAGES-UPSERT).
EVOLUTION_WEBHOOK_TOKEN=""

# Canais Fase 2b: Telegram via Bot API (só o token — sem QR).
# 1) Fale com o @BotFather no Telegram → /newbot → cole o token abaixo.
# 2) No inbox (/admin/inbox), clique em "Conectar" no cartão do Telegram.
TELEGRAM_BOT_TOKEN=""
# Segredo do webhook do Telegram (opcional; ≥8 chars). Enviado de volta pelo
# Telegram no header X-Telegram-Bot-Api-Secret-Token a cada update.
TELEGRAM_WEBHOOK_SECRET=""

# Gateway (baixa automática) — estrutura pronta, chaves quando contratar
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# --- Fase 0: rate limiting (janela fixa no Redis; sem Redis = fail-open) ---
RATE_WINDOW_MS="60000"
RATE_AUTH_MIN="5"
RATE_VERIFY_MIN="30"
RATE_BRIEFING_MIN="10"
RATE_CHECKOUT_MIN="10"
RATE_WEBHOOK_MIN="60"
RATE_EVOLUTION_MIN="300"
RATE_AI_MIN="20"

# --- Fase 3: campanhas + assistente de IA ---
# Intervalo base entre envios de campanha (ms; +jitter de até 50%). Suba para
# números novos/frios (ex. 15000–30000) para reduzir risco de banimento.
CAMPAIGN_SEND_DELAY_MS="8000"
# IA (OpenAI): sem a chave, o assistente responde em modo base (`stub: true`).
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_TTS_MODEL="tts-1"
AI_TTS_VOICE="alloy"
# Instruções extras de voz do assistente (somadas ao padrão; por turno dá para
# sobrescrever via `voicePrompt` em POST /api/ai/assistant).
ASSISTANT_SYSTEM_PROMPT=""

# --- KBOS jobs (fila BullMQ/Redis + worker) ---
REDIS_URL="redis://localhost:6379"
JOB_MAX_ATTEMPTS="5"
JOB_BASE_DELAY_MS="5000"
WORKER_CONCURRENCY="5"
WORKER_SWEEP_MS="30000"
WORKER_CRON_MS="3600000"
BRIEFING_FOLLOWUP_HOURS="48"

# --- Fase 4: alertas da agenda (job `agenda.reminders`) ---
# Para onde vão os lembretes (dígitos, ex. 5511999998888). Vazio = usa o
# telefone do usuário admin (contato@kayquebrito.com.br) no banco.
REMINDER_WHATSAPP_TO=""
# Frequência da varredura (ms). 5 min capta avisos de 15 min com folga.
REMINDER_POLL_MS="300000"
# Tolerância p/ eventos que já começaram mas ainda não avisados (min).
REMINDER_CATCHUP_MIN="60"

# --- Briefing matinal (job `briefing.morning`) ---
# Cron diário no fuso America/Sao_Paulo (BullMQ `pattern`). 08:00 por padrão.
BRIEFING_MORNING_CRON="0 8 * * *"
# Fuso usado para definir "reuniões de hoje" e o rótulo da data.
BRIEFING_TIMEZONE="America/Sao_Paulo"

# --- compose local (postgres dev; produção usa DATABASE_URL do Neon) ---
POSTGRES_PASSWORD="kbos"
WEB_PORT="3000"
# --- Evolution API (profile `evolution` no compose) ---
EVO_DB_PASSWORD="evolution"
EVO_PORT="8080"

# --- drizzle-kit ---
# drizzle.config.ts lê DATABASE_URL automaticamente

# --- Acesso admin de emergência (produção/VPS: kbos.kayquebrito.com.br) ---
# Segredo que libera `/admin/*` via cookie quando o provedor de e-mail falha.
# Gere com: openssl rand -hex 32. Mínimo 16 chars; sem ele, o bypass fica
# INATIVO e o login segue 100% via Magic Link.
# Como usar: na tela /entrar, informe o e-mail do admin + este segredo no
# campo "Senha" (vale como senha imediata, sem depender do banco).
KBOS_ADMIN_BYPASS_TOKEN=""
# Alias opcional com nome mais claro (mesmo efeito do bypass acima).
KBOS_ADMIN_PASSWORD=""
# E-mail do administrador principal (fixo no código: contato@kayquebrito.com.br)

# --- Bypass aberto da VPS (USO DIRETO SEM LOGIN — PERIGOSO) ---
# KBOS_BYPASS_ADMIN="true" libera /admin/* sem sessão nem Magic Link.
# ⚠️ Só em rede privada/firewall restrito ou temporariamente: qualquer pessoa
# com a URL vira admin total (CRM, financeiro, disparos). Padrão: ausente = login normal.

# --- Deploy pull-based (VPS se atualiza via cron + deploy.sh) ---
# Mesmo valor no /opt/kbos/.env da VPS e no secret DEPLOY_TOKEN do GitHub.
# Gere com: openssl rand -hex 32. Sem ele, POST /api/admin/deploy é 401.
DEPLOY_TOKEN=""
RATE_DEPLOY_MIN="30"
