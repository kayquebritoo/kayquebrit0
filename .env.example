# ===== KBOS — copie para .env.local (NUNCA commite) =====
# Banco Postgres (Neon, Supabase...). Sem ele, as rotas /api/* retornam 503
# com instrução — o site público segue funcionando.
# Schema: `npx drizzle-kit push` (cria as tabelas kbos_*)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# URL pública (links do magic link + callbacks)
APP_URL="http://localhost:3000"

# E-mail do magic link (Resend). Sem isso, o link aparece no terminal em dev.
RESEND_API_KEY=""
RESEND_FROM="KBOS <portal@kayquebrito.com.br>"

# WhatsApp (Evolution API). Sem isso, notificações ficam na fila como pendentes.
WHATSAPP_PROVIDER=""
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Gateway (baixa automática) — estrutura pronta, chaves quando contratar
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# --- Fase 0: rate limiting (janela fixa no Redis; sem Redis = fail-open) ---
RATE_WINDOW_MS="60000"
RATE_AUTH_MIN="5"
RATE_VERIFY_MIN="30"
RATE_BRIEFING_MIN="10"
RATE_CHECKOUT_MIN="10"
RATE_WEBHOOK_MIN="60"

# --- KBOS jobs (fila BullMQ/Redis + worker) ---
REDIS_URL="redis://localhost:6379"
JOB_MAX_ATTEMPTS="5"
JOB_BASE_DELAY_MS="5000"
WORKER_CONCURRENCY="5"
WORKER_SWEEP_MS="30000"
WORKER_CRON_MS="3600000"
BRIEFING_FOLLOWUP_HOURS="48"

# --- compose local (postgres dev; produção usa DATABASE_URL do Neon) ---
POSTGRES_PASSWORD="kbos"
WEB_PORT="3000"
# --- Evolution API (profile `evolution` no compose) ---
EVO_DB_PASSWORD="evolution"
EVO_PORT="8080"

# --- drizzle-kit ---
# drizzle.config.ts lê DATABASE_URL automaticamente
