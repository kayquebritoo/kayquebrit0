# KBOS na VPS — variáveis de ambiente (NUNCA commitar: `cp infra/.env.vps.example /opt/kbos/.env`)
# Pré-requisitos na VPS: Docker + plugin compose (`docker compose version`).

# Banco: Neon (recomendado, já em uso) OU o postgres local do compose.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
APP_URL="http://SEU-IP-OU-DOMINIO:3000"

# E-mail do magic link (Resend)
RESEND_API_KEY=""
RESEND_FROM="KBOS <portal@kayquebrito.com.br>"

# Evolution API (perfil `evolution` do compose)
EVOLUTION_API_URL="http://evolution:8080"
EVOLUTION_API_KEY="troque-por-chave-forte-32-chars"
EVOLUTION_INSTANCE="kbos-primary"
EVO_DB_PASSWORD="troque-esta-senha"
EVO_PORT="8080"

# Mercado Pago (quando contratar)
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Fila / worker
REDIS_URL="redis://redis:6379"
JOB_MAX_ATTEMPTS="5"
JOB_BASE_DELAY_MS="5000"
WORKER_CONCURRENCY="5"
WORKER_SWEEP_MS="30000"
WORKER_CRON_MS="3600000"
BRIEFING_FOLLOWUP_HOURS="48"

# Rate limiting
RATE_WINDOW_MS="60000"
RATE_AUTH_MIN="5"
RATE_VERIFY_MIN="30"
RATE_BRIEFING_MIN="10"
RATE_CHECKOUT_MIN="10"
RATE_WEBHOOK_MIN="60"
RATE_ADMIN_MIN="30"
RATE_EVOLUTION_MIN="300"
RATE_AI_MIN="20"

# Inbox Fase 2: segredo do webhook inbound (≥8 chars; vazio = sem segredo).
# Repetir em ?token= ou header x-webhook-token na config da Evolution.
EVOLUTION_WEBHOOK_TOKEN=""

# Canais Fase 2b: Telegram via Bot API (token do @BotFather; sem QR).
# Depois do deploy, conectar em /admin/inbox → cartão do Telegram.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Campanhas Fase 3: intervalo base entre envios em ms (anti-banimento).
CAMPAIGN_SEND_DELAY_MS="8000"

# Assistente IA Fase 3 (vazio = modo base/stub, sem custo).
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_TTS_MODEL="tts-1"
AI_TTS_VOICE="alloy"
ASSISTANT_SYSTEM_PROMPT=""

# Agenda Fase 4: destino dos lembretes (vazio = telefone do admin no banco).
REMINDER_WHATSAPP_TO=""
REMINDER_POLL_MS="300000"
REMINDER_CATCHUP_MIN="60"

# Compose local
POSTGRES_PASSWORD="kbos"
WEB_PORT="3000"

# Bypass admin de emergência (libera /admin/* via cookie quando o e-mail falha).
# Gere com: openssl rand -hex 32. Sem ele, o login segue 100% via Magic Link.
KBOS_ADMIN_BYPASS_TOKEN=""

# Bypass ABERTO (sem login): KBOS_BYPASS_ADMIN="true" libera /admin/* direto.
# ⚠️ Só com firewall restrito ou temporariamente — expõe admin total na URL.

# Deploy pull-based: segredo do POST /api/admin/deploy (mesmo valor no secret
# DEPLOY_TOKEN do GitHub). Gere com: openssl rand -hex 32.
DEPLOY_TOKEN=""
RATE_DEPLOY_MIN="30"

# --- LLM Gateway (somente modelos gratuitos confirmados :free) ---
# Chave OpenRouter PRÓPRIA da VPS (não reutilizar login pessoal do ChatGPT/OpenCode).
# Gere em https://openrouter.ai/keys e cole aqui (somente no .env da VPS, nunca no git).
OPENROUTER_API_KEY=""
# Token serviço-a-serviço (KBOS/Lume/Jarvis autenticam no gateway com este bearer).
# Gere com: openssl rand -hex 32. Nunca commitar.
LITELLM_MASTER_KEY=""
# Teto nominal zero: qualquer rota que gere custo é bloqueada antes da rede.
LITELLM_BUDGET_MAX="0"
